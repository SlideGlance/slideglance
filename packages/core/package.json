{
  "name": "@slideglance/core",
  "version": "0.1.0",
  "author": "Taehwan Kwag",
  "description": "Deterministic PPTX -> SVG/PNG conversion (WebAssembly).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SlideGlance/slideglance.git"
  },
  "type": "module",
  "files": [
    "dist/node/**",
    "dist/bundler/**",
    "dist/web/**",
    "README.md",
    "LICENSE-MIT"
  ],
  "scripts": {},
  "main": "./dist/node/slideglance_wasm.js",
  "types": "./dist/node/slideglance_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bundler/slideglance_wasm.d.ts",
      "node": {
        "types": "./dist/node/slideglance_wasm.d.ts",
        "default": "./dist/node/slideglance_wasm.js"
      },
      "browser": {
        "types": "./dist/bundler/slideglance_wasm.d.ts",
        "default": "./dist/bundler/slideglance_wasm.js"
      },
      "default": "./dist/bundler/slideglance_wasm.js"
    },
    "./node": {
      "types": "./dist/node/slideglance_wasm.d.ts",
      "default": "./dist/node/slideglance_wasm.js"
    },
    "./bundler": {
      "types": "./dist/bundler/slideglance_wasm.d.ts",
      "default": "./dist/bundler/slideglance_wasm.js"
    },
    "./web": {
      "types": "./dist/web/slideglance_wasm.d.ts",
      "default": "./dist/web/slideglance_wasm.js"
    }
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "ooxml",
    "svg",
    "png",
    "wasm"
  ]
}
